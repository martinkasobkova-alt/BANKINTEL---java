# Šablona produkční konfigurace. Zkopírujte jako deploy/.env NA SERVERU a vyplňte.
# Skutečný .env nikdy nepatří do gitu (.gitignore chytá .env i .env.*).

# --- Kde na hostiteli leží data (index, mirrory, snapshoty) -------------------------
# Montuje se do kontejneru jako /data read-only. Co všechno tam musí být a kolik to
# zabere: backend-java/docs/DEPLOY_DATA.md §0. Bez toho backend nastartuje, ale
# katalogové hledání jede v omezeném režimu.
DATA_DIR=/opt/bankintel/data

# --- Adresa, na které aplikace poslouchá -------------------------------------------
# Doména    -> Caddy si sám vyřídí Let's Encrypt certifikát (musí na server mířit A záznam)
# :80       -> jen HTTP, dokud doména není nasměrovaná
SITE_ADDRESS=:80

# COOKIE_SECURE=true posílá session cookie jen po HTTPS. Dokud jedete na :80, musí být
# false, jinak prohlížeč cookie zahodí a přihlášení neprojde. Přepínají se SPOLEČNĚ
# se SITE_ADDRESS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Použije se, jen když frontend běží jinde než backend. Při zdejším uspořádání
# (Caddy servíruje obojí na jednom originu) zůstávají prázdné.
FRONTEND_URL=
CORS_ORIGINS=

# --- Tajné hodnoty: VYGENERUJTE NOVÉ, nekopírujte z vývojového .env ------------------
# Vývojové tajemství na veřejném serveru znamená, že kdo se dostane ke starému notebooku
# nebo záloze, dostane se i do produkce.
#   POSTGRES_PASSWORD:  openssl rand -base64 24
#   JWT_SECRET:         openssl rand -base64 36
#   ENCRYPTION_KEY:     openssl rand -base64 32
POSTGRES_DB=bankintel
POSTGRES_USER=bankintel
POSTGRES_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# --- Klíče k externím API: tyhle se z vývojového .env přenášejí beze změny -----------
OPENAI_API_KEY=
ARAD_API_KEY=
FRED_API_KEY=
IMF_API_KEY=
IMF_API_KEY_SECONDARY=
GIE_API_KEY=
RESEND_API_KEY=
SENDER_EMAIL=

# --- Vyhledávání --------------------------------------------------------------------
SEARCH_ENGINE_VERSION=v2
SEARCH_CATALOG_INDEX=sidecar

# Noční přestavba indexu. NECHTE 0. Rebuild čte JSONL, takže vrátí ~716 tisíc řad, které
# z indexu vyřezaly prune skripty — hledání by se zaneslo mrtvými řadami.
# Podrobnosti a naměřená čísla: docs/FTS_AND_SIDECAR.md §8.
BANKINTEL_MAINTENANCE_ENABLED=0

# --- JVM ----------------------------------------------------------------------------
# Naměřený working set backendu je ~1,5 GB; 6 GB stropu nechává zbytek RAM (stroj má 15 GB)
# na page cache indexu, což je to, co drží hledání rychlé.
JAVA_TOOL_OPTIONS=-Xmx6g

# --- Nepřenášet z vývojového .env ----------------------------------------------------
# SEARCH_V2_LOCAL_RATE_LIMIT_BYPASS  obchází rate limiting — na veřejném serveru by to byl
#                                    otevřený kohoutek na váš OPENAI_API_KEY
# DEV_SEED                           zakládá testovací data
