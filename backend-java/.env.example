# BankIntel v2 local backend configuration.
# Copy to backend-java/.env and fill real secrets only there.

JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
DEV_SEED=true
FRONTEND_URL=http://localhost:5173

# Local profile uses embedded PostgreSQL. Uncomment for an external PostgreSQL instance.
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/bankintel
# DATABASE_USER=bankintel
# DATABASE_PASSWORD=bankintel

# Local data defaults. For full catalog speed, place or symlink the prebuilt FTS index here:
#   backend-java/data/catalog_search_indexes/classic_catalog_search.sqlite
BANKINTEL_DATA_DIR=./data
CATALOG_SEARCH_INDEX_DIR=./data/catalog_search_indexes
CATALOG_SEARCH_METADATA_DIR=./data/catalog_search_metadata
CLASSIC_CATALOG_FTS_DB=./data/catalog_search_indexes/classic_catalog_search.sqlite
SEARCH_ENGINE_VERSION=v2
SEARCH_CATALOG_INDEX=sidecar
SEARCH_SEMANTIC_RETRIEVAL_ENABLED=false
SEARCH_CATALOG_SIDECAR_DIR=./data/search_v2_sidecar
SEARCH_CATALOG_SIDECAR_FTS_DB=./data/search_v2_sidecar/search_v2_sidecar.sqlite

# Optional read-only reference app. Use only when you intentionally want to read existing
# Python-era data without copying it into BankIntel-v2.
# BANKINTEL_REFERENCE_ROOT=C:/Bankoapp-main/Bankoapp-main

# Optional: download a prebuilt FTS index on first boot when CLASSIC_CATALOG_FTS_DB is missing.
# FTS_INDEX_SNAPSHOT_URL=https://storage.example.com/classic_catalog_search.sqlite.gz

# Enable heuristic source router for deep search (ref catalog_source_router.py).
CATALOG_DEEP_SEARCH_SOURCE_ROUTER=0

# Multi-instance prod: set on exactly one replica for nightly jobs.
# BANKINTEL_SCHEDULER_LEADER=1

# API keys.
# OPENAI_API_KEY=
# OPENAI_MODEL_CHAT=gpt-5.4-mini
# OPENAI_MODEL_PLANNER=gpt-5.4-nano
# OPENAI_MODEL_RERANKER=gpt-5.4-nano
# OPENAI_COMMENTARY=1
# ARAD_API_KEY=
# FRED_API_KEY=
# IMF_API_KEY=
# IMF_API_KEY_SECONDARY=
# RESEND_API_KEY=
# SENDER_EMAIL=
# GIE_API_KEY=
# ALPHAVANTAGE_API_KEY=

# Explore / homepage AI.
# BANKO_HOME_RENDER_AI=1
